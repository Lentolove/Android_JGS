<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="会话列表"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="点击选择 → SharedViewModel 通知详情"
        android:textColor="@android:color/darker_gray"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_session_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Session 1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_session_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Session 2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_session_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Session 3" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_session_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Session 4" />

</LinearLayout>
